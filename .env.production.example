# Copy to .env.production on the production host. Never commit the copy.
# Create project_goods_app on the existing inventory database before enabling auth.
# Use a unique URL-safe password and keep it outside this repository.
COMPOSE_PROJECT_NAME=project_goods
# Replace these examples with names read from the running containers' mounts.
MONGO_DATA_VOLUME=project_goods_mongo-data
BACKUP_DATA_VOLUME=project_goods_backup-data
MONGO_URI=mongodb://project_goods_app:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@mongo:27017/inventory?authSource=inventory&replicaSet=rs0
# Optional, only for npm run mongo:users:init:prod (project_goods_admin, min 12 chars).
# Remove it after the users are created and keep it in a password manager.
# MONGO_ADMIN_PASSWORD=REPLACE_WITH_PASSWORD
# Optional: failed logins allowed per client IP per 15 min (default 100).
# Docker Desktop may show all LAN clients as one IP, so this budget can be shop-wide.
# LOGIN_MAX_FAILED_PER_IP=100
