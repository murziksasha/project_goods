.get(saleId),\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 1596 |         onError: (error, fallback) =>\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 1597 |           handleWorkspaceUpdateErrorRef.current(error, fallback),\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 1598 |       }),\n       | ^^^^^^^^ Passing a ref to a function may read its value during render\n  1599 |     [],\n  1600 |   );\n  1601 |   /* eslint-enable react-hooks/refs */",["2540"],{"kind":"2541","justification":"2542"},"directive",""]