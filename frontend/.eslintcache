.ts",[],[],{"ruleId":"2547","severity":2,"message":"2548","line":1592,"column":38,"nodeType":null,"endLine":1598,"endColumn":8,"suppressions":"2549"},"react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\nC:\\Users\\murzi\\Desktop\\project\\project_goods\\frontend\\src\\widgets\\dashboard\\ui\\orders\\workspace\\OrdersWorkspace.tsx:1592:38\n  1590 |   const workspaceQueue = useMemo(\n  1591 |     () =>\n> 1592 |       createSaleWorkspaceUpdateQueue({\n       |                                      ^\n> 1593 |         persist: (sale, payload) =>\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 1594 |           persistSaleWorkspaceRawRef.current(sale, payload),\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 1595 |         getLatestSale: (saleId) => latestSalesRef.current.get(saleId),\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 1596 |         onError: (error, fallback) =>\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 1597 |           handleWorkspaceUpdateErrorRef.current(error, fallback),\n       | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 1598 |       }),\n       | ^^^^^^^^ Passing a ref to a function may read its value during render\n  1599 |     [],\n  1600 |   );\n  1601 |   /* eslint-enable react-hooks/refs */",["2550"],{"kind":"2551","justification":"2552"},"directive",""]